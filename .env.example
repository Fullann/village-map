# ==========================================
# Base de données PostgreSQL (o2switch cPanel)
# ==========================================
DATABASE_URL=postgresql://cpaneluser_dbuser:motdepasse@localhost:5432/cpaneluser_villagedb

# Clé secrète JWT pour signer la session (générer avec : openssl rand -hex 32)
AUTH_SECRET=remplacer_par_une_longue_chaine_aleatoire_de_64_caracteres

# URL publique du site sur o2switch
NEXT_PUBLIC_APP_URL=https://mon-village.ch

# ==========================================
# Serveur SMTP (Email o2switch pour Magic Link)
# ==========================================
SMTP_HOST=mail.mon-village.ch
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@mon-village.ch
SMTP_PASS=motdepasse_email_o2switch
SMTP_FROM="Village en Fête <no-reply@mon-village.ch>"

# ==========================================
# Stockage Objet S3 optionnel (MinIO, R2, Scaleway, AWS)
# Laisser vide pour utiliser le stockage local standard (public/uploads/)
# ==========================================
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_BUCKET=village-map-uploads
# S3_REGION=fr-par
# S3_ACCESS_KEY_ID=SCWXXXXXXXXXXXX
# S3_SECRET_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# S3_PUBLIC_URL=https://cdn.mon-village.ch
